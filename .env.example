# Example configuration for Apollo
# Copy this file to .env and adjust. Every value below is optional — the
# defaults shown are what the app uses when the variable is unset.

# ============ OLLAMA (chat, embeddings, vision captions) ============
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_DEFAULT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_FALLBACK_MODEL=all-MiniLM-L6-v2
OLLAMA_REQUEST_TIMEOUT=30

# Vision model used by "Generate captions with AI" in LoRA Studio.
# Must be a multimodal model, e.g. `ollama pull llava` or `ollama pull llama3.2-vision`.
OLLAMA_VISION_MODEL=llava
OLLAMA_VISION_TIMEOUT=180

# ============ RAG ============
RAG_CHUNK_SIZE=800
RAG_CHUNK_OVERLAP=150
RAG_TOP_K=4

# ============ COMFYUI ============
# URL of your locally running ComfyUI instance.
COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_TIMEOUT=30
COMFYUI_POLL_INTERVAL=1.0
COMFYUI_GENERATION_TIMEOUT=600

# Where this app stores workflow JSON + node mappings.
COMFYUI_WORKFLOW_DIR=./workflows

# ComfyUI's own models/loras folder. Set this so the LoRA library can also see
# LoRAs you downloaded or copied in manually. Leave empty to skip that scan.
# Example: COMFYUI_LORA_DIR=W:/Data/Packages/ComfyUI/models/loras
COMFYUI_LORA_DIR=

# ============ OSTRIS AI TOOLKIT (LoRA training) ============
# Clone from https://github.com/ostris/ai-toolkit and install it separately.
# Both must be set and must exist, or training is disabled (the rest of the
# app keeps working). Forward slashes are fine on Windows.
# Example: AI_TOOLKIT_PATH=W:/AI-Toolkit
# Example: AI_TOOLKIT_PYTHON=W:/AI-Toolkit/venv/Scripts/python.exe
AI_TOOLKIT_PATH=
AI_TOOLKIT_PYTHON=

# ============ LOCAL STORAGE ============
LORA_DATA_DIR=./data/loras
GENERATED_DIR=./data/generated
JOBS_FILE=./data/jobs.json

# ============ UPLOAD LIMITS ============
MAX_IMAGE_UPLOAD_MB=25

# ============ LAUNCHER ============
PORT=8000
# CLOUDFLARED_PATH=
